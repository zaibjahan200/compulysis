# frontend/.env.example
# Copy this file to .env and update with your actual values

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
# AWS stack example:
# VITE_API_URL=https://api-aws.yourdomain.com/api/v1
# Vercel stack example:
# VITE_API_URL=https://your-backend-vercel-domain.vercel.app/api/v1

# Backend uses this for password reset email links
FRONTEND_URL=https://compulysis.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Application Configuration
VITE_APP_NAME=Compulysis
VITE_APP_VERSION=1.0.0

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
